{
  "name": "sitecheck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sitecheck/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
