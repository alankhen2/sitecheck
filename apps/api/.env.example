# Copy to .env (never commit .env). Matches the defaults in docker-compose.yml.
DATABASE_URL="postgresql://sitecheck:sitecheck@localhost:5432/sitecheck?schema=public"
PORT=3000
# Password for the demo users created by `db:seed` (required when NODE_ENV=production).
SEED_PASSWORD="sitecheck-dev"
# Signs session tokens (HS256). At least 32 characters; use a random value per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="replace-me-with-a-random-value-of-32-plus-chars"
# How many proxies sit in front of the API, so the login rate limit sees each user's own
# address. 0 (no proxy) ignores X-Forwarded-For. Too low: all users share one limit.
# Too high: clients can fake their address and dodge the limit.
TRUST_PROXY=0
# Whether POST /auth/register works. New accounts are inspectors, who can change data,
# so leave this off on any server the public can reach. Off when not set.
ALLOW_REGISTRATION=false
